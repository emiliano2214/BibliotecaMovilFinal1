@page "/reserva-form"

@using BibliotecaMovil.Shared.DTOs
@using BibliotecaMovil.Shared.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject NavigationManager Nav
@inject IReservaService ReservaService
@inject ILibroService LibroService
@inject BibliotecaMovil.Services.UsuarioSesionService Sesion

@attribute [Authorize]

<div style="background:#777FF5; min-height:100vh; display:flex; flex-direction:column;">

    <!-- Header -->
    <div style="padding:60px 20px 20px 20px; display:grid; grid-template-columns:1fr auto; align-items:flex-start;">
        <div style="font-size:28px; font-weight:bold;">Nueva Reserva</div>
        <div style="display:flex; gap:10px;">
            <div @onclick="Volver"
                 style="background:white; padding:10px 14px; border-radius:10px; font-weight:bold; cursor:pointer;">
                Volver
            </div>
            <NavLink href="/menu" style="text-decoration:none; color:black; display:block;">
                <div style="background:#0050FF; padding:8px 6px; display:flex; flex-direction:column; gap:3px; cursor:pointer;">
                    <div style="height:2px; width:20px; background:black;"></div>
                    <div style="height:2px; width:20px; background:black;"></div>
                    <div style="height:2px; width:20px; background:black;"></div>
                </div>
            </NavLink>
        </div>
    </div>

    <!-- Body -->
    <div style="flex:1; background:white; padding:20px;">

        @if (!string.IsNullOrWhiteSpace(debugError))
        {
            <div style="background:#ffcccc; color:#600; padding:10px; border:2px solid red; margin-bottom:10px;">
                <b>ERROR</b><br /><pre style="white-space:pre-wrap; margin:0;">@debugError</pre>
            </div>
        }

        @if (isLoading)
        {
            <div style="padding:12px; border:2px solid #777FF5; border-radius:8px;">Cargando...</div>
        }
        else if (!string.IsNullOrWhiteSpace(error))
        {
            <div style="padding:12px; border:2px solid #ff3b3b; border-radius:8px; background:#ffecec; margin-bottom:10px;">
                <div style="font-weight:bold;">Error</div>
                <div style="font-size:14px;">@error</div>
            </div>
        }

        @if (!isLoading)
        {
            <div style="display:grid; gap:16px; max-width:480px;">

                <div>
                    <div style="font-weight:bold; margin-bottom:6px;">Libro a reservar</div>
                    <select class="form-select" @onchange="OnLibroChange">
                        <option value="0">-- Selecciona un libro --</option>
                        @foreach (var l in libros)
                        {
                            <option value="@l.IdLibro">@l.Titulo</option>
                        }
                    </select>
                </div>

                @if (libroIdSeleccionado > 0)
                {
                    <div style="padding:12px; background:#f0f4ff; border-radius:8px; border:2px solid #777FF5; font-size:14px;">
                        <b>Libro:</b> @libroSeleccionado?.Titulo<br />
                        Seras agregado al final de la cola de reservas para este libro.
                    </div>
                }

                <div style="display:flex; gap:10px; margin-top:6px;">
                    <button @onclick="Guardar"
                            disabled="@(isSaving || libroIdSeleccionado == 0)"
                            style="background:#0050FF; border:none; padding:12px 16px; border-radius:10px;
                                   font-weight:bold; cursor:pointer;">
                        @(isSaving ? "Reservando..." : "Confirmar reserva")
                    </button>
                    <button type="button" @onclick="Volver"
                            style="background:white; border:2px solid #777FF5; padding:12px 16px;
                                   border-radius:10px; font-weight:bold; cursor:pointer;">
                        Cancelar
                    </button>
                </div>

            </div>
        }

    </div>
</div>

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private string? error;
    private string? debugError;

    private List<LibroDto> libros = new();
    private int libroIdSeleccionado = 0;
    private LibroDto? libroSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            error = null;

            var usuario = await Sesion.ObtenerUsuarioAsync();
            if (usuario is null) { Nav.NavigateTo("/"); return; }

            libros = await LibroService.GetLibrosAsync() ?? new();
        }
        catch (Exception ex)
        {
            error = "No se pudieron cargar los libros.";
            debugError = ex.ToString();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnLibroChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            libroIdSeleccionado = id;
            libroSeleccionado = libros.FirstOrDefault(l => l.IdLibro == id);
        }
        else
        {
            libroIdSeleccionado = 0;
            libroSeleccionado = null;
        }
    }

    private async Task Guardar()
    {
        try
        {
            error = null;
            debugError = null;

            if (libroIdSeleccionado == 0)
            {
                error = "Selecciona un libro para reservar.";
                return;
            }

            isSaving = true;
            var (ok, msgError) = await ReservaService.CreateReservaAsync(libroIdSeleccionado);

            if (!ok)
            {
                error = msgError ?? "No se pudo crear la reserva.";
                return;
            }

            Nav.NavigateTo("/reservas");
        }
        catch (Exception ex)
        {
            error = "Error al crear la reserva.";
            debugError = ex.ToString();
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Volver() => Nav.NavigateTo("/reservas");
}
