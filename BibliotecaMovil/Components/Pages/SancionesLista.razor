@page "/sanciones"
@using BibliotecaMovil.Shared.DTOs
@using BibliotecaMovil.Shared.Interfaces
@using Microsoft.AspNetCore.Components.Routing

@inject ISancionService SancionService
@inject NavigationManager Nav

<div style="background:#777FF5; min-height:100vh; display:flex; flex-direction:column;">
    <!-- Header -->
    <div style="padding:60px 20px 20px 20px; display:grid; grid-template-columns:1fr auto; align-items:flex-start;">
        <div style="font-size:28px; font-weight:bold;">Mis sanciones</div>

        <NavLink href="/menu" style="text-decoration:none; color:black; display:block;">
            <div style="background:#0050FF; padding:8px 6px; display:flex; flex-direction:column; gap:3px; cursor:pointer;">
                <div style="height:2px; width:20px; background:black;"></div>
                <div style="height:2px; width:20px; background:black;"></div>
                <div style="height:2px; width:20px; background:black;"></div>
            </div>
        </NavLink>
    </div>

    <!-- Contenido -->
    <div style="flex:1; background:white; padding:20px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; gap:10px; flex-wrap:wrap;">
            <div style="font-weight:bold; font-size:22px;">Lista de sanciones</div>
        </div>

        @if (cargando)
        {
            <div style="padding:12px; border:2px solid #777FF5; border-radius:8px;">
                Cargando sanciones...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(error))
        {
            <div style="padding:12px; border:2px solid #ff3b3b; border-radius:8px; background:#ffecec;">
                <div style="font-weight:bold;">Error</div>
                <div style="font-size:14px;">@error</div>
            </div>
        }
        else if (sanciones.Count == 0)
        {
            <div style="padding:12px; border:2px dashed #777FF5; border-radius:8px;">
                No tenés sanciones ✅
            </div>
        }
        else
        {
            <!-- Resumen -->
            <div style="
                    background:white;
                    border-radius:12px;
                    padding:14px 12px;
                    margin-bottom:14px;
                    display:flex;
                    flex-direction:column;
                    gap:10px;
                    border:2px solid #777FF5;">

                <div style="font-weight:bold; font-size:22px; line-height:1.2;">
                    Resumen
                </div>

                <div style="font-size:15px;">
                    <span style="font-weight:bold;">Total sanciones:</span> @sanciones.Count
                </div>

                <div style="font-size:15px;">
                    <span style="font-weight:bold;">Activas:</span> @sanciones.Count(s => s.EstaActiva)
                </div>

                <div style="font-size:15px;">
                    <span style="font-weight:bold;">Monto total:</span> $ @(sanciones.Sum(s => s.Monto ?? 0m).ToString("N0"))
                </div>
            </div>

            @foreach (var s in sanciones.OrderByDescending(x => x.FechaInicio))
            {
                <div style="
                            background:white;
                            border-radius:12px;
                            padding:14px 12px;
                            margin-bottom:14px;
                            display:flex;
                            flex-direction:column;
                            gap:8px;
                            border:2px solid #777FF5;
                        ">
                    <div style="font-weight:bold; font-size:22px; line-height:1.2;">
                        Sanción préstamo #@s.IdPrestamo
                    </div>

                    <div style="font-size:15px;">
                        <span style="font-weight:bold;">Fecha:</span> @s.FechaInicio.ToString("dd/MM/yyyy")
                    </div>

                    <div style="font-size:15px;">
                        <span style="font-weight:bold;">Motivo:</span> @s.Motivo
                    </div>

                    <div style="font-size:15px;">
                        <span style="font-weight:bold;">Monto:</span> $ @((s.Monto ?? 0m).ToString("N0"))
                    </div>

                    <div style="
                                width:fit-content;
                                padding:6px 10px;
                                border-radius:999px;
                                font-weight:bold;
                                font-size:13px;
                                background-color:@ObtenerFondoEstado(s);
                                color:@ObtenerColorEstado(s);">
                        @ObtenerEstadoVisual(s)
                    </div>

                    <div style="margin-top:6px;">
                        <button @onclick="() => IrADetalle(s.IdPrestamo)"
                                style="background:#0050FF; border:none; padding:8px 12px; font-weight:bold; cursor:pointer;">
                            Ver detalle
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private bool cargando = true;
    private string? error;
    private List<SancionDto> sanciones = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cargando = true;
            error = null;

            sanciones = await SancionService.GetMisSancionesAsync() ?? new List<SancionDto>();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerEstadoVisual(SancionDto s)
    {
        return s.EstaActiva ? "Activa" : "Pagada";
    }

    private string ObtenerColorEstado(SancionDto s)
    {
        return s.EstaActiva ? "#b00020" : "#0f5132";
    }

    private string ObtenerFondoEstado(SancionDto s)
    {
        return s.EstaActiva ? "#f8d7da" : "#d1e7dd";
    }

    private void IrADetalle(int prestamoId)
        => Nav.NavigateTo($"/sanciones/{prestamoId}");

    private void Volver()
        => Nav.NavigateTo("/home");
}