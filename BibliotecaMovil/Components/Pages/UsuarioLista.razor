@page "/usuarios"
@using BibliotecaMovil.Shared.DTOs
@using BibliotecaMovil.Shared.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IUsuarioService UsuarioService
@inject NavigationManager Nav
@inject BibliotecaMovil.Services.UsuarioSesionService Sesion

@attribute [Authorize(Roles = "Admin,Bibliotecario")]

<div style="background:#777FF5; min-height:100vh; display:flex; flex-direction:column;">

    <div style="padding:60px 20px 20px 20px; display:flex; flex-direction:column; gap:30px;">
        <div style="font-size:28px; font-weight:bold;">
            Usuarios
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; gap:10px;">

            <div style="display:flex; gap:10px; align-items:center;">
                <div style="width:40px; height:40px; background:#0050FF;"></div>

                @if (usuarioActual is not null && (usuarioActual.NombreRol == "Admin"))
                {
                    @if (usuarioActual is not null && usuarioActual.NombreRol == "Admin")
                    {
                        <button style="height:40px; padding:0 12px; background:#0050FF; border:none; cursor:pointer;"
                            @onclick="IrNuevo">
                            ➕ Nuevo
                        </button>
                    }
                }
            </div>

            <NavLink href="/menu" style="text-decoration:none;">
                <div style="
                    width:40px; height:40px;
                    background:#0050FF;
                    display:flex;
                    flex-direction:column;
                    align-items:center;
                    justify-content:center;
                    gap:4px;
                    cursor:pointer;">
                    <div style="height:2px; width:18px; background:black;"></div>
                    <div style="height:2px; width:18px; background:black;"></div>
                    <div style="height:2px; width:18px; background:black;"></div>
                </div>
            </NavLink>

        </div>
    </div>

    <div style="flex:1; background:white; padding:16px 14px 24px 14px;">
        <div style="padding:0 6px 14px 6px; font-weight:bold; font-size:22px;">Lista de Usuarios</div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div style="margin:0 6px 12px 6px; padding:10px 12px; color:#b00020; font-weight:bold; background:#ffe5ea; border-radius:10px;">
                Error: @error
            </div>
        }

        @if (cargando)
        {
            <div style="padding:20px;">Cargando...</div>
        }
        else if (!usuarios.Any())
        {
            <div style="padding:20px;">No hay usuarios disponibles.</div>
        }
        else
        {
            <div style="display:flex; flex-direction:column; gap:14px;">
                @foreach (var usuario in usuarios)
                {
                    <div style="
                                background:#f8f8f8;
                                border-radius:18px;
                                padding:12px;
                                display:grid;
                                grid-template-columns:72px 1fr auto;
                                column-gap:12px;
                                align-items:center;
                                box-shadow:0 2px 8px rgba(0,0,0,0.10);">

                        <!-- IMAGEN -->
                        <div style="
                                    width:72px;
                                    height:72px;
                                    border-radius:50%;
                                    overflow:hidden;
                                    background:#d0d0d0;
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;">
                            @if (!string.IsNullOrWhiteSpace(usuario.ImgUrl))
                            {
                                <img src="@usuario.ImgUrl"
                                     alt="Foto usuario"
                                     style="width:100%; height:100%; object-fit:cover;" />
                            }
                            else
                            {
                                <div style="width:100%; height:100%; background:gray;"></div>
                            }
                        </div>

                        <!-- DATOS -->
                        <div style="display:flex; flex-direction:column; gap:6px; min-width:0;">
                            <div style="font-size:22px; font-weight:bold; line-height:1.1;">
                                @usuario.Nombre @usuario.Apellido
                            </div>

                            <div style="font-size:14px; color:#444;">
                                @usuario.Email
                            </div>

                            <div style="font-size:13px; color:#666;">
                                Rol: @usuario.NombreRol
                            </div>

                            <div style="font-size:13px; color:#666;">
                                Estado: @(usuario.Activo ? "Activo" : "Inactivo")
                            </div>
                        </div>

                        <!-- ACCIONES -->
                        <div style="display:flex; flex-direction:column; align-items:center; gap:10px;">
                            <button style="
                                        min-width:88px;
                                        height:36px;
                                        padding:0 10px;
                                        background:#DDDDDD;
                                        border:none;
                                        border-radius:8px;
                                        cursor:pointer;"
                                    @onclick="() => IrEditar(usuario.IdUsuario)">
                                ✏️ Editar
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<UsuarioPublicoDto> usuarios = new();

    private bool cargando = true;
    private string? error;

    private UsuarioPublicoDto? usuarioActual;

    protected override async Task OnInitializedAsync()
    {
        usuarioActual = await Sesion.ObtenerUsuarioAsync();

        if (usuarioActual is null)
        {
            error = "No hay sesión iniciada.";
            cargando = false;
            return;
        }

        try
        {
            usuarios = await UsuarioService.GetAllAsync() ?? new();
        }
        catch (Exception ex)
        {
            error = "GET Usuarios falló: " + ex.Message;
        }

        cargando = false;
    }

    private void IrNuevo() => Nav.NavigateTo("/registro");

    private void IrEditar(int idUsuario) => Nav.NavigateTo($"/usuario-form/{idUsuario}");
}