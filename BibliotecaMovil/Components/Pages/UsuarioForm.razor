@page "/usuario-form"
@page "/usuario-form/{IdUsuario:int}"

@using BibliotecaMovil.Shared.DTOs
@using BibliotecaMovil.Shared.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.IO

@inject NavigationManager Nav
@inject IUsuarioService UsuarioService
@inject IRolService RolService
@inject BibliotecaMovil.Services.UsuarioSesionService Sesion
@inject BibliotecaMovil.Services.CloudinaryService CloudinaryService

@attribute [Authorize(Roles = "Admin,Bibliotecario")]

<div style="background:#777FF5; min-height:100vh; display:flex; flex-direction:column;">
    <div style="padding:40px 20px 10px 20px; display:grid; grid-template-columns:auto 1fr auto; column-gap:10px; align-items:center;">
        <div style="width:80px; height:80px; background:white; display:flex; align-items:center; justify-content:center;">
            @if (!string.IsNullOrWhiteSpace(previewImagen))
            {
                <img src="@previewImagen"
                     alt="Foto usuario"
                     style="width:64px; height:64px; object-fit:cover; border-radius:8px;" />
            }
            else
            {
                <div style="width:64px; height:64px; background:gray; border-radius:8px;"></div>
            }
        </div>

        <div style="font-weight:bold; font-size:22px;">
            @(EsEdicion ? "Editar Usuario" : "Nuevo Usuario")
        </div>

        <div style="background:#0050FF; width:40px; height:40px; display:flex; align-items:center; justify-content:center; cursor:pointer;"
             @onclick="IrUsuarios">
            <span style="font-size:22px;">👤</span>
        </div>
    </div>

    <div style="flex:1; background:white; padding:20px;">
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div style="
                    background:#ffdddd;
                    color:#900;
                    padding:10px;
                    margin-bottom:15px;
                    border-radius:6px;
                    word-break:break-all;
                    overflow-wrap:anywhere;">
                ⚠️ @error
            </div>
        }

        @if (cargando)
        {
            <div style="padding:10px;">Cargando...</div>
        }
        else
        {
            <EditForm Model="form" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div>Nombre</div>
                <InputText @bind-Value="form.Nombre"
                           style="width:100%; height:34px; background:#DDDDDD; border:none; margin-bottom:10px;" />

                <div>Apellido</div>
                <InputText @bind-Value="form.Apellido"
                           style="width:100%; height:34px; background:#DDDDDD; border:none; margin-bottom:10px;" />

                @if (!EsEdicion)
                {
                    <div>Email</div>
                    <InputText @bind-Value="form.Email"
                               style="width:100%; height:34px; background:#DDDDDD; border:none; margin-bottom:10px;" />

                    <div>Password</div>
                    <InputText @bind-Value="form.Password"
                               type="password"
                               style="width:100%; height:34px; background:#DDDDDD; border:none; margin-bottom:10px;" />
                }

                <div>Foto de perfil</div>
                <InputFile OnChange="SeleccionarImagenUsuario"
                           accept="image/*"
                           style="margin-bottom:10px;" />

                @if (!string.IsNullOrWhiteSpace(nombreImagenSeleccionada))
                {
                    <div style="margin-bottom:15px; font-size:13px;">
                        Archivo: @nombreImagenSeleccionada
                    </div>
                }

                <div style="border:2px solid #777FF5; padding:15px; margin-bottom:15px;">

                    <div>Rol</div>
                    <InputSelect @bind-Value="form.IdRol"
                                 style="width:100%; height:34px; background:#DDDDDD; border:none; margin-bottom:10px;">
                        <option value="0">-- Seleccione un rol --</option>
                        @foreach (var rol in roles)
                        {
                            <option value="@rol.IdRol">@rol.NombreRol</option>
                        }
                    </InputSelect>

                    @if (EsEdicion)
                    {
                        <div style="margin-top:10px; margin-bottom:10px;">
                            <label style="display:flex; align-items:center; gap:8px;">
                                <InputCheckbox @bind-Value="form.Activo" />
                                <span>Usuario activo</span>
                            </label>
                        </div>
                    }

                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; grid-column-gap:20px; margin-top:10px;">
                    <button type="submit"
                            disabled="@guardando"
                            style="height:44px; background:#0050FF; border:none; color:black;">
                        @(guardando ? "Guardando..." : "Aceptar")
                    </button>

                    <button type="button"
                            disabled="@guardando"
                            style="height:44px; background:red; border:none; color:black;"
                            @onclick="Cancelar">
                        Cancelar
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter]
    public int? IdUsuario { get; set; }

    private bool EsEdicion => IdUsuario.HasValue && IdUsuario.Value > 0;

    private UsuarioFormModel form = new();
    private List<RolDto> roles = new();

    private string? error;
    private bool cargando;
    private bool guardando;
    private bool rolesCargados = false;

    private IBrowserFile? imagenSeleccionada;
    private string? previewImagen;
    private string? nombreImagenSeleccionada;

    private UsuarioPublicoDto? usuarioSesionActual;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            cargando = true;
            error = null;

            usuarioSesionActual = await Sesion.ObtenerUsuarioAsync();
            if (usuarioSesionActual is null)
            {
                Nav.NavigateTo("/", true);
                return;
            }

            if (usuarioSesionActual.NombreRol != "Admin" && usuarioSesionActual.NombreRol != "Bibliotecario")
            {
                Nav.NavigateTo("/menu", true);
                return;
            }

            // Alta -> solo Admin
            if (!EsEdicion && usuarioSesionActual.NombreRol != "Admin")
            {
                Nav.NavigateTo("/usuarios", true);
                return;
            }

            if (!rolesCargados)
            {
                await CargarRoles();
                rolesCargados = true;
            }

            if (EsEdicion)
            {
                var usuario = await UsuarioService.GetByIdAsync(IdUsuario!.Value);
                if (usuario is null)
                {
                    error = "No se encontró el usuario.";
                    return;
                }

                form = new UsuarioFormModel
                {
                    IdUsuario = usuario.IdUsuario,
                    Nombre = usuario.Nombre,
                    Apellido = usuario.Apellido,
                    Email = usuario.Email,
                    Password = "",
                    IdRol = usuario.IdRol,
                    ImgUrl = usuario.ImgUrl,
                    Activo = usuario.Activo
                };

                previewImagen = usuario.ImgUrl;
                nombreImagenSeleccionada = null;
                imagenSeleccionada = null;
            }
            else
            {
                form = new UsuarioFormModel
                {
                    IdRol = 0,
                    Activo = true
                };

                previewImagen = null;
                nombreImagenSeleccionada = null;
                imagenSeleccionada = null;
            }
        }
        catch (Exception ex)
        {
            error = "Error inicializando formulario: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarRoles()
    {
        try
        {
            roles = await RolService.GetRolesAsync() ?? new();
        }
        catch (Exception ex)
        {
            error = "Error cargando roles: " + ex.Message;
        }
    }

    private async Task SeleccionarImagenUsuario(InputFileChangeEventArgs e)
    {
        error = null;
        imagenSeleccionada = e.File;
        nombreImagenSeleccionada = null;
        previewImagen = null;

        if (imagenSeleccionada is null)
            return;

        if (!imagenSeleccionada.ContentType.StartsWith("image/"))
        {
            error = "El archivo seleccionado no es una imagen válida.";
            imagenSeleccionada = null;
            return;
        }

        nombreImagenSeleccionada = imagenSeleccionada.Name;

        using var ms = new MemoryStream();
        await imagenSeleccionada.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
        var base64 = Convert.ToBase64String(ms.ToArray());
        previewImagen = $"data:{imagenSeleccionada.ContentType};base64,{base64}";
    }

    private async Task Guardar()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(form.Nombre))
        {
            error = "El nombre es obligatorio.";
            return;
        }

        if (form.IdRol <= 0)
        {
            error = "Debe seleccionar un rol.";
            return;
        }

        if (!EsEdicion)
        {
            if (string.IsNullOrWhiteSpace(form.Email))
            {
                error = "El email es obligatorio.";
                return;
            }

            if (string.IsNullOrWhiteSpace(form.Password))
            {
                error = "La password es obligatoria.";
                return;
            }
        }

        try
        {
            guardando = true;

            if (imagenSeleccionada is not null)
            {
                var resultadoUpload = await CloudinaryService.SubirImagenAsync(
                    imagenSeleccionada,
                    "Imagenes/Usuarios"
                );

                if (resultadoUpload is null || string.IsNullOrWhiteSpace(resultadoUpload.Url))
                {
                    error = "No se pudo subir la imagen del usuario.";
                    return;
                }

                form.ImgUrl = resultadoUpload.Url;
            }

            bool ok;

            if (EsEdicion)
            {
                var dtoUpdate = new UsuarioActualizadoDto
                {
                    IdUsuario = IdUsuario!.Value,
                    Nombre = form.Nombre.Trim(),
                    Apellido = string.IsNullOrWhiteSpace(form.Apellido) ? null : form.Apellido.Trim(),
                    IdRol = form.IdRol,
                    ImgUrl = form.ImgUrl,
                    Activo = form.Activo
                };

                ok = await UsuarioService.UpdateAsync(dtoUpdate);
            }
            else
            {
                var dtoCreate = new UsuarioCreadoDto
                {
                    Nombre = form.Nombre.Trim(),
                    Apellido = string.IsNullOrWhiteSpace(form.Apellido) ? null : form.Apellido.Trim(),
                    Email = form.Email.Trim(),
                    Password = form.Password.Trim(),
                    IdRol = form.IdRol,
                    ImgUrl = form.ImgUrl
                };

                ok = await UsuarioService.CreateAsync(dtoCreate);
            }

            if (!ok)
            {
                error = EsEdicion
                    ? "No se pudo actualizar el usuario."
                    : "No se pudo crear el usuario.";
                return;
            }

            Nav.NavigateTo("/usuarios");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private void Cancelar() => Nav.NavigateTo("/usuarios");
    private void IrUsuarios() => Nav.NavigateTo("/usuarios");

    private sealed class UsuarioFormModel
    {
        public int IdUsuario { get; set; }
        public string Nombre { get; set; } = "";
        public string? Apellido { get; set; }
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public int IdRol { get; set; }
        public string? ImgUrl { get; set; }
        public bool Activo { get; set; } = true;
    }
}